# Firebase Admin SDK. Use the service-account JSON as one-line JSON.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}

# Firebase Web API key used only if you retain the legacy Apps Script backend.
FIREBASE_API_KEY=

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN.com/api/google/callback

# 32-byte base64/hex secret used to encrypt Google refresh tokens at rest.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional: comma-separated emails allowed to self-verify as CR during onboarding.
CR_INVITE_EMAILS=
# Optional: comma-separated emails allowed to self-verify as CR via invite code.
CR_INVITE_CODE=

# Used to sign OAuth state and other short-lived server state.
APP_STATE_SECRET=
